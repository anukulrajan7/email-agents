# Copy to .env and fill in. Never commit real secrets.
RUST_LOG=info,tower_http=info
DATABASE_URL=sqlite://data/email_ai.db
API_BIND_ADDR=127.0.0.1:8080
PUBLIC_WEB_URL=http://localhost:5173
# Deep links in alert emails (default https://mail.anukulraj.tech).
APP_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080

# Auth: "password" (email + password accounts), "oidc", or "dev" (any email signs in as dev:<email>).
# Dev mode only starts with ALLOW_DEV_AUTH=1, a non-https PUBLIC_WEB_URL and a loopback API_BIND_ADDR.
# For a quick local demo: AUTH_MODE=dev and ALLOW_DEV_AUTH=1.
AUTH_MODE=password
ALLOW_DEV_AUTH=
SIGNUP_ENABLED=true
# Sign-up is by invitation. Comma-separated domains / emails that may sign up without an invite.
# Both empty: only invited emails, plus the very first account (bootstrap admin).
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
# Email verification codes (OTP). Hostinger: smtp.hostinger.com, 465 (SSL) or 587 (STARTTLS).
# Empty SMTP_HOST/USERNAME => verification disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OIDC_ISSUER_URL=
OIDC_AUDIENCE=

# Forwarding ingestion (Resend Inbound)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
INBOUND_DOMAIN=inbound.localhost
# Local demo only: lets admins inject a sample email through the real pipeline
ALLOW_TEST_EMAILS=true

# Connected mailboxes via Nango (Gmail). Empty key => "Connect Gmail" reports not configured.
NANGO_API_KEY=
# Webhook signing key (Environment Settings > Webhooks). Comma-separate old,new during rotation.
NANGO_WEBHOOK_SECRET=
NANGO_GMAIL_INTEGRATION_ID=google-mail
NANGO_GMAIL_MODEL=GmailEmail
NANGO_BACKFILL_DAYS=14
NANGO_BACKFILL_MAX=500

# Classification (TypeSafe AI Jev). Empty key => rules-based fallback, labelled "fallback".
TYPESAFE_API_KEY=
JEV_MODEL_ID=jev-latest
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# OpenRouter. Classifier (efficient, used when no Jev key) and drafter (higher quality).
# Empty key/model => rules classifier / template drafts.
OPENROUTER_API_KEY=
OPENROUTER_CLASSIFIER_MODEL_ID=qwen/qwen3.8-flash
OPENROUTER_MODEL_ID=moonshotai/kimi-k2.6
# Explicit models (no silent use of OPENROUTER_MODEL_ID): escalation only when the classifier's confidence is below 0.5,
# memory from the team's replies, and label suggestions.
OPENROUTER_ESCALATION_MODEL_ID=deepseek/deepseek-v4-pro
OPENROUTER_LEARN_MODEL_ID=deepseek/deepseek-v4-flash
OPENROUTER_SUGGEST_MODEL_ID=deepseek/deepseek-v4-flash
# Drafting tiers: routine replies use the standard model; premium is used for high priority, client mail,
# many asks and "Write a better draft". Premium defaults to OPENROUTER_MODEL_ID.
OPENROUTER_DRAFT_MODEL_ID=deepseek/deepseek-v4-flash
OPENROUTER_PREMIUM_MODEL_ID=deepseek/deepseek-v4-pro
# Email understanding v2: one structured call instead of classify + analyze + judges.
# UNDERSTAND_V2=off (today's calls) | shadow (v2 runs beside them; GET /workspaces/{ws}/understanding-shadow
# reports label agreement, switch only at >= 95%) | on (v2 decides; today's calls are the fallback).
UNDERSTAND_V2=off
OPENROUTER_UNDERSTAND_MODEL_ID=deepseek/deepseek-v4-flash

# Daily AI spend caps (USD, UTC day). Per workspace for automatic extras; global for labelling + embedding
# of new mail (above it: rules labels, embedding waits until the email is opened).
AI_DAILY_BUDGET_USD=2
AI_GLOBAL_DAILY_BUDGET_USD=10

EMAIL_RETENTION_DAYS=30
JOB_WORKER_CONCURRENCY=2
OPENROUTER_PLANNER_MODEL_ID=deepseek/deepseek-v4-pro
# Assistant voice input (push-to-talk speech to text). Empty turns voice off; typing still works.
OPENROUTER_AUDIO_MODEL_ID=qwen/qwen3-asr-1.7b
